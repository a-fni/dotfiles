# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# Force override (helps with zsh issues)
shell-integration-features = no-cursor

# --- Font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-style = regular

# --- Font features ---
font-feature = liga
font-feature = calt

# --- Keyboard ---
macos-option-as-alt = true

# --- Better rendering ---
theme = Dracula
background-opacity = 0.95

# --- Padding ---
window-padding-x = 6
window-padding-y = 6
